# Environment Configuration Example for SmartTicket Distributed System

# Database Settings
DB_HOST=mysqldb
DB_PORT=3306
DB_NAME=smartticketdb
DB_USER=root
DB_PASSWORD=root

# Redis Cache Settings
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Service Integration Settings
SEAT_SERVICE_URL=http://seat-service:8080
VITE_API_BASE_URL=http://localhost/api
